                    dd = 2;
                    break;
                case "2":
                    $("#hot_article_ph_2023").find('ul').hide().end().find('ul:eq(2)').show();
                    dd = 0;
                    break;
                case "0":
                    $("#hot_article_ph_2023").find('ul').hide().end().find('ul:eq(0)').show();
                    dd = 1;
                    break;
            }
